GEMINI_API_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,https://daechul-recommend.vercel.app
INTOSS_APP_NAME=daechul-recommend
BEHIND_PROXY=false

# 금리 데이터 외부 API 키
